NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use one public key variable. The code supports either name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Alternative name if using the new Supabase publishable key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. NEVER expose this value in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=
